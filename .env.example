# Copy to .env.local (or set in your host's env settings). All optional: you can edit lib/config.js instead.
# Your GitHub repo that holds the Release with the APK:
NEXT_PUBLIC_GITHUB_REPO=YOUR_USERNAME/YOUR_REPO
# Exact file name of the APK attached to the Release:
NEXT_PUBLIC_APK_FILE=al-mudabbir.apk
# Or set a full direct link instead of the two lines above:
# NEXT_PUBLIC_DOWNLOAD_URL=https://github.com/YOUR_USERNAME/YOUR_REPO/releases/latest/download/al-mudabbir.apk
# Your site's public address (used for the share image):
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
